{
  "crash": { "property": "noErrorBoundary", "flow": "explore" },
  "spinner": { "property": "spinnersSettle", "flow": "buy", "time": "1m" },
  "leak": { "property": "noLeakedValues", "flow": "buy" },
  "overflow": { "property": "noHorizontalOverflow", "flow": "explore" },
  "silent-write": { "property": "failedWritesAreShown", "flow": "buy", "faults": 0.5 },
  "noisy": { "property": "noConsoleErrorsUnlessFaulted", "flow": "explore" },
  "overlap": { "property": "noTextOverLogo", "flow": "explore" },
  "blank": { "property": "appRenders", "flow": "explore" },
  "empty": { "property": "noBlankPages", "flow": "explore" },
  "throw": { "property": "noUncaughtExceptions", "flow": "buy" },
  "reject": { "property": "noUnhandledPromiseRejections", "flow": "buy", "faults": 0.5 }
}
